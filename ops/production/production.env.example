# Copy upstream .env.example first; replace ALL upstream sample secrets.
# This file contains only FinFolk overrides, never production credentials.
SUPABASE_PUBLIC_URL=https://supabase.finfolk.com.au
API_EXTERNAL_URL=https://supabase.finfolk.com.au
SITE_URL=https://finfolk.com.au
ADDITIONAL_REDIRECT_URLS=https://finfolk.com.au/account
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_HOST=postfix
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@finfolk.com.au
SMTP_SENDER_NAME=FinFolk
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
PGRST_DB_SCHEMAS=public
POSTGRES_DB=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Set pinned image@sha256 values after image validation.
TRAEFIK_IMAGE=
SOCKET_PROXY_IMAGE=
POSTFIX_IMAGE=
# For production mail, include compose.resend-relay.yml after verifying the domain.
# Store a sending-only Resend key in /srv/finfolk/secrets/resend-smtp-token (0600).
# Never put the key in this environment file.
ACME_EMAIL=

# Owner chose fresh accounts; email confirmation remains required.
DISABLE_SIGNUP=false
