# Isolated local Supabase only. Never put production database credentials here.
DATABASE_URL=postgresql://postgres:REPLACE@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVER_ONLY_KEY
FINFOLK_AUTH_PROVIDER=supabase
FINFOLK_SUPABASE_URL=http://127.0.0.1:54321
FINFOLK_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_LOCAL_PUBLISHABLE_KEY
FINFOLK_GOOGLE_AUTH_ENABLED=false
FINFOLK_GITHUB_AUTH_ENABLED=false
ENVIRONMENT=development

# Sole Instagram path: Meta/Facebook Page token shared by messaging and comments.
INSTAGRAM_MESSAGING_PROVIDER=instagram-facebook
INSTAGRAM_MESSAGING_META_APP_ID=1667613151655339
INSTAGRAM_MESSAGING_META_APP_SECRET=REPLACE
INSTAGRAM_MESSAGING_PAGE_ID=1387107281155901
INSTAGRAM_MESSAGING_ACCOUNT_ID=17841461601419539
INSTAGRAM_MESSAGING_GRAPH_VERSION=v26.0
INSTAGRAM_MESSAGING_REDIRECT_URI=https://api.finfolk.com.au/v1/integrations/instagram/oauth/callback
INSTAGRAM_COMMAND_REPLIES_ENABLED=false
INSTAGRAM_COMMENT_MODE=paused

# Runtime feature gates. API secret and local app.manage credential must match.
# Generate a random value of at least 32 characters; never use a NEXT_PUBLIC_ name.
FINFOLK_FLAG_MANAGEMENT_TOKEN=REPLACE_WITH_RANDOM_FLAG_MANAGEMENT_CREDENTIAL
FINFOLK_FLAG_API_ORIGIN=https://api.finfolk.com.au
FINFOLK_FEATURE_ENVIRONMENT=production
FINFOLK_FLAG_OPERATOR=app.manage
