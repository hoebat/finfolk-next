{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finfolk-next-site",
  "main": "backend/preview-worker.mjs",
  "compatibility_date": "2026-10-30",
  "account_id": "b048221dbe18365ea667373f6fda1f73",
  "workers_dev": false,
  "routes": [],
  "assets": {
    "directory": ".cache/next-site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "services": [
    {
      "binding": "NEXT_API",
      "service": "finfolk-next-api"
    }
  ]
}
