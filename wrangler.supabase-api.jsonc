{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finfolk-supabase-api",
  "main": "backend/supabase-api-worker.mjs",
  "account_id": "b048221dbe18365ea667373f6fda1f73",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "hyperdrive": [
    {
      "binding": "SUPABASE_DB",
      "id": "e1d8eb9dc02548a38ba611488bbae711"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SUPABASE_URL": "https://supabase.finfolk.com.au",
    "NATIVE_SCHEMA_SHA": "e846ff0010b9a63363108659555f74e9251ce26396d39461e03804ebaf9bee5e",
    "FINFOLK_FEATURE_ENVIRONMENT": "production"
  },
  "routes": [
    {
      "pattern": "api.finfolk.com.au",
      "custom_domain": true
    }
  ]
}
