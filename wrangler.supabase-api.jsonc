{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finfolk-supabase-api",
  "main": "backend/supabase-api-worker.mjs",
  "account_id": "b048221dbe18365ea667373f6fda1f73",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "hyperdrive": [
    {
      "binding": "SUPABASE_DB",
      "id": "e1d8eb9dc02548a38ba611488bbae711"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "SUPABASE_URL": "https://supabase.finfolk.com.au",
    "NATIVE_SCHEMA_SHA": "1c5b4ceae62cf952b2a4fe7cc1b24b563b4003f7c06053c65f4b247bee2a2e3c",
    "FINFOLK_FEATURE_ENVIRONMENT": "production",
    "NATIVE_BUDDIES_SCHEMA": "true"
  },
  "routes": [
    {
      "pattern": "api.finfolk.com.au",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "NATIVE_SOCIAL_SERVICE",
      "service": "finfolk-native-social"
    }
  ]
}
